{
  "name": "crypto-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DEBUG=app:* nodemon",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "cross-env NODE_ENV=production DEBUG=app:* node dist/server.js",
    "lint": "next lint",
    "prepare": "husky install",
    "lint:js": "eslint --fix --ignore-pattern \"\\.next\"  \"**/*.{js,jsx,ts,tsx}\"",
    "lint:css": "stylelint --fix --ignore-pattern \"\\.next\"  \"**/*.{css,scss}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write .",
      "npm run lint:js"
    ],
    "*.{css,scss}": [
      "prettier --write .",
      "npm run lint:css"
    ]
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.8",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "debug": "^4.4.0",
    "eslint": "9.21.0",
    "framer-motion": "^12.4.7",
    "joi": "^17.13.3",
    "next": "^15.1.7",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-spinners": "^0.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "eslint-config-next": "^15.1.7",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "sass": "^1.77.1",
    "stylelint": "^16.14.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.11.1",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "^5.7.3"
  }
}
