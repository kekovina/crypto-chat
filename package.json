{
  "name": "crypto-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DEBUG=app:* next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "lint:js": "eslint --fix --ignore-pattern \"\\.next\"  \"**/*.{js,jsx,ts,tsx}\"",
    "lint:css": "stylelint --fix --ignore-pattern \"\\.next\"  \"**/*.{css,scss}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write .",
      "npm run lint:js"
    ],
    "*.{css,scss}": [
      "prettier --write .",
      "npm run lint:css"
    ]
  },
  "dependencies": {
    "@next/font": "14.2.15",
    "@tailwindcss/postcss": "^4.0.8",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "debug": "^4.4.0",
    "eslint": "9.21.0",
    "framer-motion": "^12.4.7",
    "joi": "^17.13.3",
    "next": "^15.1.7",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.0.8",
    "unique-names-generator": "^4.7.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "eslint-config-next": "^15.1.7",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "sass": "^1.85.0",
    "typescript": "^5.7.3"
  }
}
